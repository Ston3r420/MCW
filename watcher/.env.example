# MCW Backend URL
MCW_API_URL=http://localhost:3001

# API key — must match WATCHER_API_KEY in the backend .env
MCW_API_KEY=change_me_to_a_secret_key

# Path to Marbles on Stream session save folder
# Default location on most Windows installs:
MOS_SESSIONS_PATH=C:\Users\YOUR_USERNAME\AppData\Local\MarblesOnStream\Saved\SaveGames\Sessions

# How often to poll for new files (milliseconds) — 5000 = every 5 seconds
POLL_INTERVAL_MS=5000

# Set to true to log every file check (noisy, useful for debugging)
DEBUG=false
