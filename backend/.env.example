# Server
PORT=3001
NODE_ENV=development

# Session secret — change this to a long random string in production
SESSION_SECRET=change_me_to_something_long_and_random

# Twitch OAuth
# Get these from https://dev.twitch.tv/console
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_CALLBACK_URL=http://localhost:3001/auth/twitch/callback

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173

# Watcher API Key — any secret string, used by the watcher script to authenticate
WATCHER_API_KEY=change_me_to_a_secret_key

# Database — PostgreSQL connection string
# Local dev example: postgresql://postgres:password@localhost:5432/mcw
# Neon example:      postgresql://user:pass@ep-xyz.us-east-1.aws.neon.tech/mcw?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/mcw
